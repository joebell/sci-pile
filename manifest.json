{
  "manifest_version": 3,
  "name": "Sci-Pile",
  "version": "0.10.2",
  "description": "Resolve a DOI through user-configured sources, save the PDF, and import it into Paperpile.",
  "minimum_chrome_version": "111",
  "permissions": [
    "activeTab",
    "downloads",
    "offscreen",
    "scripting",
    "storage",
    "tabs"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "host_permissions": [
    "https://app.paperpile.com/*",
    "https://api.crossref.org/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://app.paperpile.com/my-library/*"],
      "js": ["src/paperpile/paperpile-export-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://scholar.google.com/*"],
      "css": ["src/scholar/scholar.css"],
      "js": ["src/scholar/scholar.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.paperpile.com/my-library/*"],
      "js": [
        "src/paperpile/paperpile-menu-core.js",
        "src/paperpile/paperpile-menu.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "Sci-Pile: find a PDF for the first DOI on this page",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png"
    }
  },
  "options_page": "src/options/options.html"
}
